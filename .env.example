# Values are sourced by a shell in the root migrate scripts — quote any value
# containing spaces, & or ?.
DATABASE_URI=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The registrable domain apps/api derives its CORS allowlist from —
# https://pos.<APP_DOMAIN> and https://admin.<APP_DOMAIN> (ADR-0001, PRD
# "The CORS allowlist is two of the four origins"). Not decided; the
# four-origin shape is. Locally this is deanpos.localhost, which resolves to
# loopback and gets Caddy's internal certificate authority with no DNS.
APP_DOMAIN=

# The container image tag every service is deployed at — a git commit SHA,
# `git rev-parse --short=12 HEAD`. docker-compose.yml defaults it to `dev`, so
# a local `docker compose up --build` needs nothing set. Rolling back is
# setting this to a previous SHA and running `docker compose up -d`.
IMAGE_TAG=
