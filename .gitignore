# dependencies
node_modules/

# build output
dist/
build/
.next/
*.tsbuildinfo

# Next rewrites this on every `next dev`/`next build`; its own header says not
# to edit it, so it is not ours to track either.
apps/landing/next-env.d.ts

# generated — regenerated by `vp run -w codegen`, excluded from review diffs (ADR-0004)
**/generated/**

# secrets. `.env.example` carries names and no values, and IS committed.
.env
.env.*
!.env.example

# test + tooling artefacts
coverage/
*.log
.vitest/

# python (tools/lofi)
__pycache__/
*.pyc

# os
.DS_Store

# pipeline lane worktrees
.worktrees/
.worktree

# TanStack Router scratch dir, regenerated on every dev run
.tanstack/

.playwright-cli