# One file, both environments: Caddy picks the certificate issuer from the
# hostname (internal CA for .localhost, Let's Encrypt otherwise). APP_DOMAIN
# is not decided (ADR-0001, PRD); see decision record 011 for the full case.

{$APP_DOMAIN:deanpos.localhost} {
	reverse_proxy landing:3000
}

pos.{$APP_DOMAIN:deanpos.localhost} {
	root * /srv/pos
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

admin.{$APP_DOMAIN:deanpos.localhost} {
	root * /srv/admin
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

api.{$APP_DOMAIN:deanpos.localhost} {
	# header_up with an explicit value replaces rather than appends, so the
	# API always receives exactly one address, the one Caddy actually saw —
	# no attacker-supplied X-Forwarded-For to trust (record 033).
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}
