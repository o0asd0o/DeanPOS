generator client {
  provider = "prisma-kysely"
  output   = "./generated"
  fileName = "types.ts"
}

datasource db {
  provider = "postgresql"
}

// Single-row table with no domain meaning; area 04 reads it through Kysely
// to prove the connection pipe. Deleted when a real slice replaces it.
model Ping {
  id        Int      @id @default(autoincrement())
  message   String   @default("pong")
  createdAt DateTime @default(now())
}

// The isolation root (ADR-0002). Outside tenant RLS by construction — no
// tenant_id column of its own, reachable only through platform-admin paths
// (issue 02).
model Tenant {
  id         String      @id
  name       String
  createdAt  DateTime    @default(now())
  stores     Store[]
  users      User[]
  userRoles  UserRole[]
  userStores UserStore[]
}

// Deactivated, never deleted (issue 01 acceptance criteria). RLS ENABLED and
// FORCED in the same migration that creates this table.
model Store {
  id                String      @id
  tenantId          String      @map("tenant_id")
  name              String
  // `HH:mm`, 24-hour, the exact string an `<input type="time">` produces —
  // no TIME column and no timezone conversion (issue 05, record 040 §2).
  businessDayStart  String      @default("00:00") @map("business_day_start")
  // An ordered list of free strings; order is only expressible as the whole
  // array, which is why the editor saves it whole (issue 05, ADR-0011).
  tableLabels       String[]    @default([]) @map("table_labels")
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  userStores        UserStore[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

enum Role {
  cashier
  manager
  admin
}

// Belongs to a Tenant. `email` is globally unique, not merely unique per
// Tenant — see issue 03's `## Comments` for why sign-in requires that.
model User {
  id                 String      @id
  tenantId           String      @map("tenant_id")
  email              String      @unique
  passwordHash       String      @map("password_hash")
  mustChangePassword Boolean     @default(true) @map("must_change_password")
  role               Role
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  sessions           Session[]
  userRoles          UserRole[]
  userStores         UserStore[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

// Effective-dated history of the Role a User held (issue 04, PRD security
// criterion 21); `User.role` stays a denormalised convenience, this is the
// truth. `user`'s composite FK avoids an RLS bypass (round 1 finding 2).
model UserRole {
  id            String   @id
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  role          Role
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  user          User     @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@index([tenantId])
  @@unique([userId, effectiveFrom])
}

// Effective-dated history of which Stores a User may operate (issue 04).
// Append-only like UserRole; un-assigning writes a closing row
// (`assigned = false`) rather than deleting the prior one.
// `user` and `store` are composite FKs on (tenantId, userId) / (tenantId,
// storeId), for the same reason as UserRole.user above.
model UserStore {
  id            String   @id
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  storeId       String   @map("store_id")
  assigned      Boolean  @default(true)
  effectiveFrom DateTime @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  user          User     @relation(fields: [tenantId, userId], references: [tenantId, id])
  store         Store    @relation(fields: [tenantId, storeId], references: [tenantId, id])

  @@index([tenantId])
  @@unique([userId, storeId, effectiveFrom])
}

// Back-office session (issue 03): an opaque server-side id, persistent with
// an explicit absolute expiry plus a sliding idle expiry. Revocation is a
// column, never a delete, so a revoked row still explains itself in an audit.
model Session {
  id         String    @id
  userId     String    @map("user_id")
  tenantId   String    @map("tenant_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

// The platform-admin principal — distinct from any Tenant's User by
// construction: no tenantId, and no code path treats it as one (issue 02).
model PlatformAdmin {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
}

// Append-only: every platform-admin action writes one row naming the actor,
// the action, and the Tenant (issue 02 acceptance criteria).
model PlatformAuditLog {
  id              String   @id
  platformAdminId String   @map("platform_admin_id")
  action          String
  tenantId        String   @map("tenant_id")
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

// Sign-in rate limiting. Keyed on the submitted string, never a User row —
// an enumeration oracle otherwise (record 033). No tenant_id, no RLS: see
// this table's migration.
model SignInThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @default(now()) @map("updated_at")
}
