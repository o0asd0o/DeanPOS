{
  "name": "deanpos",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "codegen": "vp exec -F backend prisma generate && vp exec -F pos tsr generate && vp exec -F backoffice tsr generate",
    "dev": "set -a; [ -f .env ] && . ./.env; set +a; vp run --parallel -F api -F pos -F backoffice -F landing dev",
    "migrate": "set -a; [ -f .env ] && . ./.env; set +a; vp exec -F backend prisma migrate deploy",
    "migrate:status": "set -a; [ -f .env ] && . ./.env; set +a; vp exec -F backend prisma migrate status",
    "prepare": "vp run -w codegen",
    "stack": "bash scripts/stack.sh"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5",
    "fast-check": "4.9.0",
    "@orpc/contract": "1.14.13",
    "@orpc/client": "1.14.13",
    "@orpc/server": "1.14.13",
    "@orpc/tanstack-query": "1.14.13",
    "zod": "4.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "1.28.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/router-plugin": "1.168.23",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/react-query": "5.101.4",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.11.1"
  }
}
