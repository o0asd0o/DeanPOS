{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["es2023", "dom", "dom.iterable"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "next-env.d.ts", ".next/types/**/*.ts"]
}
