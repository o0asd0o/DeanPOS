# orc2 pipeline config for DeanPOS — edit, then run: orc2 render
ORC2_A11Y="WCAG 2.2 AA"
ORC2_AGENTS_FILE=""
ORC2_BUILD_ORDER="foundation tenancy-identity catalog checkout offline-sync drawer-sessions reporting observability hardening release-ops landing workforce"
ORC2_CODEGEN="yes"
ORC2_CODEGEN_CMD="vp run -w codegen"
ORC2_DB="postgres"
ORC2_DB_SLUG="deanpos"
ORC2_DB_URI_VAR="DATABASE_URI"
ORC2_DESIGN="lofi"
ORC2_DEV_DB="DeanPOS_dev"
ORC2_FIGMA_FILE_KEY=""
ORC2_FIGMA_ROOT_NODE=""
ORC2_GATE="vp check; vp run -r check; vp run -r test"
ORC2_GENERATED_PATHS="**/generated/**"
ORC2_LANES="1"
ORC2_LANE_PREFIX="DeanPOS_lane_"
ORC2_LOFI_DIR="design/lofi"
ORC2_MAIN_BRANCH="main"
ORC2_MIGRATE_CMD="vp run -w migrate"
ORC2_MIGRATE_STATUS_CMD="vp run -w migrate:status"
ORC2_MODEL_BUILD="claude-sonnet-5"
ORC2_MODEL_GATE="claude-opus-5"
ORC2_MODEL_JUDGE="claude-opus-4-8"
ORC2_MODEL_SCAN="haiku"
ORC2_NOTIFY="slack"
ORC2_PIPELINE_DIR=".orc2"
ORC2_PROJECT="DeanPOS"
ORC2_ROUND_CAP="2"
ORC2_RUNNER="claude"
ORC2_RUNNER_MECH="claude"
ORC2_SKILLS_PIN="2ab958093e83e0ec752e6c1c5932da465bf23e0c"
ORC2_SKILLS_REPO="mattpocock/skills"
ORC2_SLACK_CHANNEL="deanpos"
ORC2_SLACK_ENV="ORC2_SLACK_WEBHOOK"
ORC2_SLACK_MENTION="U0BFRT9U3DZ"
ORC2_TRACKER="scratch"
ORC2_TRACKER_ONE_LINER=$'Local markdown \342\200\224 issues and PRDs live under `.scratch/<feature-slug>/`; no `gh`, no remote.'
ORC2_WORKTREE_DIR=".worktrees"
